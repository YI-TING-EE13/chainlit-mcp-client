# OpenAI-compatible LLM backend
# LM Studio default local server:
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=google/gemma-4-e4b

# Optional legacy fallback variables.
# These are kept for backward compatibility.
# Prefer LLM_* for new setups.
# OLLAMA_HOST=http://localhost:11434/v1
# OLLAMA_KEY=ollama
# OLLAMA_MODEL=<your-ollama-model>

# Optional app settings
ASSISTANT_NAME=ArXiv Insight Assistant

# Optional generation settings.
# Leave provider-specific options empty unless your backend supports them.
LLM_NUM_CTX=
LLM_MAX_TOKENS=
LLM_TEMPERATURE=0.8
LLM_TOP_P=
LLM_TOP_K=
LLM_REPEAT_PENALTY=
LLM_NUM_PREDICT=

# MCP sampling defaults
SAMPLING_NUM_CTX=
SAMPLING_MAX_TOKENS=4096
SAMPLING_TEMPERATURE=0.8
SAMPLING_TOP_P=
SAMPLING_TOP_K=
SAMPLING_REPEAT_PENALTY=
SAMPLING_NUM_PREDICT=

# Optional token usage settings
TOKEN_USAGE_ENABLED=false
TOKENIZER_MODEL=cl100k_base

# Optional memory settings
MEMORY_ENABLED=false
MEMORY_DB_PATH=.data/memory.sqlite
MEMORY_DEFAULT_INCOGNITO=false
MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_MAX_TOKENS=512
MEMORY_SUMMARY_SCHEDULER_ENABLED=true
MEMORY_SUMMARY_INTERVAL_SECONDS=600
